# Configuration de référence WORKMAN ERP 360 (API Laravel 12).
APP_NAME="WORKMAN ERP 360 API"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=54322
DB_DATABASE=postgres
# Compte à privilèges minimaux (migration 0033). Son mot de passe se définit hors dépôt :
# alter role workman_api password '<secret>';  puis le reporter dans .env (jamais dans ce fichier).
DB_USERNAME=workman_api
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
SUPABASE_JWT_SECRET=
SUPABASE_URL=
