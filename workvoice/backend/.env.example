# --- Serveur ---------------------------------------------------------
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Base de données (MySQL 8.0+) -----------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=workvoice
DB_USER=root
DB_PASSWORD=

# Compte restreint aux vues anonymisées (optionnel en dev, recommandé en prod).
# Voir database/02_views_security.sql. Vide = utilise le compte principal.
DB_DIRECTION_USER=
DB_DIRECTION_PASSWORD=

# --- JWT --------------------------------------------------------------
# Au moins 32 caractères aléatoires en production :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-please-0123456789
JWT_EXPIRES_IN=8h

# --- Pièces jointes ---------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- E-mails (vide = e-mails affichés dans la console) ----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="WORKVOICE <workvoice@workman.tn>"
