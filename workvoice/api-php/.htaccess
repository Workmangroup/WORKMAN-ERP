# WORKVOICE — API PHP (Apache / OVH)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fichiers internes jamais accessibles depuis le web
    RewriteRule ^(config\.php|lib/|routes/|uploads/) - [F,L]

    # Toutes les routes passent par index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "^(config\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Taille maximale des envois (pièce jointe de 5 Mo + marge)
<IfModule mod_php.c>
    php_value upload_max_filesize 6M
    php_value post_max_size 8M
</IfModule>
